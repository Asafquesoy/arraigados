# Variables para correr el backend en modo desarrollo LOCAL (sin Docker).
# Copia este archivo a backend/.env

# SQLite es lo más simple para desarrollo local (no requiere instalar nada).
# Para usar Postgres local en su lugar:
# DATABASE_URL=postgresql+psycopg2://usuario:clave@localhost:5432/arraigados
DATABASE_URL=sqlite:///./dev.db

SECRET_KEY=clave-de-desarrollo-no-usar-en-produccion
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

PUBLIC_ORIGIN=http://localhost:5173

TICKETS_DIR=./data/tickets

# Opcional: lee monto/fecha/referencia de los comprobantes (gratis en aistudio.google.com)
GEMINI_API_KEY=
