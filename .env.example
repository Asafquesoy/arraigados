# Copia este archivo a .env y ajusta los valores antes de desplegar.

# Postgres
POSTGRES_USER=arraigados
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=arraigados

# Backend
SECRET_KEY=genera-una-clave-larga-y-aleatoria
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave-tambien

# Dominio público del frontend (usado para CORS y cookie segura)
PUBLIC_ORIGIN=https://tu-dominio-o-ip.com
